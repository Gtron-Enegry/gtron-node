# gtron-node configuration. Copy to /etc/gtron-node/node.env (root, mode 0600) for systemd,
# or to .env next to the binary (your user, mode 0600) when running by hand.
# The wallet key does NOT go here: put it in its own file (mode 0400) and point
# NODE_PRIVATE_KEY_FILE at it (the systemd unit already does).

NODE_API_URL=https://api.gtron.network
# Provider key of your shop (cabinet → Shop → API keys), scope `jobs`.
NODE_API_KEY=pk_live_...

# Your own TRON node, or TronGrid with a free API key (without one TronGrid throttles hard).
TRONGRID_URL=https://api.trongrid.io
TRONGRID_API_KEY=

# Who this agent may delegate to. The platform names the client's address per job, so for
# a public shop this is "any"; set an allowlist instead if you serve known clients only.
NODE_ALLOW_ANY_RECEIVER=1
# NODE_ALLOWED_RECEIVERS=TXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX,TYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYY

# Local caps, enforced whatever the platform asks (SUN of stake; 1 TRX = 1 000 000 SUN).
# They bound what a compromised platform account could make this wallet do.
NODE_MAX_BALANCE_SUN=50000000000
NODE_MAX_DAILY_BALANCE_SUN=200000000000
NODE_MAX_LOCKED_BALANCE_SUN=500000000000
NODE_MAX_LOCK_SECONDS=2592000

# Keep delegations locked for the rental: the platform only counts locked ones in agent mode.
NODE_LOCK_DELEGATIONS=true

# Log level: error, warn, info, debug.
RUST_LOG=info
